# Copy to .env.local (never committed) and fill in. On Netlify, set these under
# Site configuration > Environment variables instead.
# Groq is tried first (fast), Gemini is the backup. One key is enough to work.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash-lite
